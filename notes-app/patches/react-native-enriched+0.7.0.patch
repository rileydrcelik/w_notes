+/* True when the run holds nothing but whitespace. Serialized bodies put a
+   newline between block tags, and HTML parses each of those into a text node
+   sitting between the two blocks. Wrapping one in <p> turns insignificant
+   layout whitespace into a real empty paragraph — a visible blank line at
+   every block boundary, which then gets saved back into the note. */
+static bool buffer_is_blank(const buffer_t *b) {
+  for (size_t i = 0; i < b->len; i++) {
+    if (!isspace((unsigned char)b->data[i]))
+      return false;
+  }
+  return true;
+}
+
 static void flush_inline_p(buffer_t *ib, buffer_t *out) {
   if (ib->len > 0) {
+    if (buffer_is_blank(ib)) {
+      buffer_clear(ib);
+      return;
+    }
     buffer_append_str(out, "<p>");
     buffer_append(out, ib->data, ib->len);
     buffer_append_str(out, "</p>");
