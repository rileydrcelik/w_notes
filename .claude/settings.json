{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/delegation-policy.json\"",
            "statusMessage": "Loading delegation policy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/track-edits.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/commit-reminder.mjs\"",
            "statusMessage": "Checking for uncommitted work",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./.venv/Scripts/python.exe -m pytest)",
      "Bash(./.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m pytest)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(MSYS_NO_PATHCONV=1 aws logs *)",
      "Bash(MSYS_NO_PATHCONV=1 aws ecs describe-services *)"
    ]
  }
}
